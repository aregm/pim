{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "received",
        "preserved",
        "failed",
        "duplicate"
      ]
    },
    "existing": {
      "type": "boolean"
    }
  },
  "required": [
    "item_id",
    "state",
    "existing"
  ],
  "additionalProperties": false
}
