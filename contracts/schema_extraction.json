{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entities": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "organisation",
              "concept",
              "place"
            ]
          },
          "aliases": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "evidence": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "kind",
          "aliases",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "evidence": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "dates": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "iso": {
            "type": "string",
            "maxLength": 10
          },
          "evidence": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "iso",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 1200
            },
            "evidence": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "text",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "entities",
    "tags",
    "dates",
    "summary",
    "title"
  ],
  "additionalProperties": false
}
