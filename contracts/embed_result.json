{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string"
    },
    "model_digest": {
      "type": "string"
    },
    "dim": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "vector"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "model",
    "model_digest",
    "dim",
    "vectors"
  ],
  "additionalProperties": false
}
